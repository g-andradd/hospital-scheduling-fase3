# Copie para .env antes de subir a infraestrutura:  cp .env.example .env
# O arquivo .env e ignorado pelo Git — nunca versione credenciais reais.

# PostgreSQL
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USER=hospital
RABBITMQ_PASSWORD=hospital
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Segredo do JWT HS256, compartilhado pelos tres servicos.
# Minimo de 32 bytes. Gere o seu:  openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-no-minimo-32-bytes
